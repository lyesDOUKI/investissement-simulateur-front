# Facultatif : laisser non défini pour les défauts plateforme.
# EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Mock OIDC local. Le secret est réservé à l'environnement de développement.
# EXPO_PUBLIC_OIDC_TOKEN_URL=http://localhost:8091/realms/investissement-simulateur/token
EXPO_PUBLIC_OIDC_CLIENT_ID=investissement-simulateur-api
EXPO_PUBLIC_OIDC_CLIENT_SECRET=replace-with-local-mock-secret

# Comparaison reste indisponible jusqu'à l'ajout de l'API correspondante.
EXPO_PUBLIC_FEATURE_COMPARISON=false
# Le flux compte/mot de passe et inscription reste désactivé.
EXPO_PUBLIC_FEATURE_ACCOUNT_AUTH=false
# Mettre false uniquement pour revenir à l'adapter fake en développement.
EXPO_PUBLIC_USE_HTTP_API=true
